{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about",     "destination": "/about.html" },
    { "source": "/inventory", "destination": "/inventory.html" },
    { "source": "/contact",   "destination": "/contact.html" },
    { "source": "/blog",      "destination": "/blog.html" },
    { "source": "/faq",       "destination": "/faq.html" }
  ],
  "redirects": [
    { "source": "/faq.html",       "destination": "/faq",       "permanent": true },
    { "source": "/about.html",     "destination": "/about",     "permanent": true },
    { "source": "/inventory.html", "destination": "/inventory", "permanent": true },
    { "source": "/contact.html",   "destination": "/contact",   "permanent": true },
    { "source": "/blog.html",      "destination": "/blog",      "permanent": true },

    { "source": "/product-page/8x8-tent-rental", "destination": "/inventory#tents", "permanent": true },
    { "source": "/product-page/10-x10-tent-rental", "destination": "/inventory#tents", "permanent": true },
    { "source": "/product-page/20-x-20-tent-rentals", "destination": "/inventory#tents", "permanent": true },
    { "source": "/product-page/outdoor-table-and-chair-rentals-20-chairs-2-tables", "destination": "/inventory#event-extras", "permanent": true },
    { "source": "/product-page/outdoor-table-and-chair-rentals-40-chairs-4-tables", "destination": "/inventory#event-extras", "permanent": true },
    { "source": "/product-page/outdoor-indoor-projector-blow-up-screen-package", "destination": "/inventory#event-extras", "permanent": true },
    { "source": "/product-page/giant-jenga-rental", "destination": "/inventory#life-size-games", "permanent": true },
    { "source": "/product-page/golf-pong-game-rental", "destination": "/inventory#games", "permanent": true },
    { "source": "/product-page/pool-couch-blow-up-combo", "destination": "/inventory", "permanent": true },
    { "source": "/product-page/combo-bounce-house-with-curved-slide-rental-policyrental", "destination": "/inventory", "permanent": true },
    { "source": "/product-page/:path*", "destination": "/inventory", "permanent": true },
    { "source": "/category/:path*", "destination": "/inventory", "permanent": true },
    { "source": "/info", "destination": "/about", "permanent": true }
  ]
}
